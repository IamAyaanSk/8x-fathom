{
  "name": "worker",
  "version": "1.0.0",
  "description": "Meeting dispatch scheduler",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "imports": {
    "#src/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development ./src/server.ts",
    "clean": "rimraf dist",
    "build": "tsc",
    "start": "node ./dist/server.js",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@repo/ai": "workspace:*",
    "@repo/api-contract": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/meeting-dispatch": "workspace:*",
    "@repo/shared-validations": "workspace:*",
    "express": "catalog:",
    "helmet": "catalog:",
    "morgan": "catalog:",
    "node-cron": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/express": "catalog:",
    "@types/morgan": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
