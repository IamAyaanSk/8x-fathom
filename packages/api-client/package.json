{
  "name": "@repo/api-client",
  "version": "1.0.0",
  "description": "API client with fetch functions and hooks",
  "type": "module",
  "imports": {
    "#src/*": "./dist/*.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./v1/*": {
      "types": "./src/v1/*.ts",
      "default": "./dist/v1/*.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "dev": "tsc --watch",
    "build": "tsc",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/api-contract": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "axios": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "zod": "catalog:"
  }
}
