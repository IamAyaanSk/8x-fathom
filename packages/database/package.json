{
  "name": "@repo/db",
  "version": "1.0.0",
  "description": "Prisma DB package for postgres",
  "type": "module",
  "imports": {
    "#generated/*": "./dist/generated/*.js",
    "#src/*": "./dist/src/*.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "db:generate": "prisma generate && tsc",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist",
    "dev": "tsc --watch",
    "build": "tsc"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "dotenv": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "prisma": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  }
}
