{
  "name": "@repo/shared-utils",
  "version": "1.0.0",
  "description": "Shared utilities",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
