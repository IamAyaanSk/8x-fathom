{
  "name": "@repo/shared-validations",
  "version": "1.0.0",
  "description": "Shared zod schemas",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./meeting": {
      "types": "./src/meeting.ts",
      "default": "./dist/meeting.js"
    },
    "./summary": {
      "types": "./src/summary-template.ts",
      "default": "./dist/summary-template.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "dev": "tsc --watch",
    "build": "tsc",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "zod": "catalog:"
  }
}
