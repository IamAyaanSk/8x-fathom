{
  "$schema": "https://v2-10-5.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["DATABASE_URL", "NODE_ENV"],
  "tasks": {
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "dependsOn": ["//#lint:fix"],
      "cache": false
    },

    "topo": {
      "dependsOn": ["^topo"]
    },
    "check-types": {
      "dependsOn": ["topo"]
    },

    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "EXPO_OS"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },

    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:generate"]
    },

    "start": {
      "persistent": true
    },

    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    },
    "db:studio": {
      "cache": false
    },
    "ios": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:generate"]
    },
    "android": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:generate"]
    }
  }
}
